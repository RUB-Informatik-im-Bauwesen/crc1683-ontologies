<http://w3id.org/lcao>
  rdf:type owl:Ontology ;
  owl:imports <http://w3id.org/lcdmo> ;
  <http://purl.org/dc/terms/contributor> _:genid1 ;
                         <http://purl.org/dc/terms/created> "2025-12-10"^^xsd:date ;
                         <http://purl.org/dc/terms/modified> "2026-11-26"^^xsd:date ;
                         <http://purl.org/dc/terms/creator> _:genid3 ;
                         <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                         <http://purl.org/dc/terms/source> "https://github.com/RUB-Informatik-im-Bauwesen/crc1683-ontologies/tree/main/lcao"^^xsd:anyURI ;
                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "lcao" ;
                         rdfs:comment "LCAO represents life cycle assessment knowledge through a semantic structure closely aligned with ILCD and ILCD+EPD datasets, encompassing processes, exchanges, flows, flow properties, units, and assessment results. Its modular organisation supports the creation of reusable LCA profiles assembled from interlinked datasets, allowing these profiles to be adapted and applied across different assessment studies and projects."@en ;
                         rdfs:label "LCAO Ontology" .

_:genid1 rdf:type <https://schema.org/Person> ;
