  lcao:containsLCA-DataSets lcao:UnitGroup_2 ;
.
lcao:LCI-Method
  rdf:type owl:Class ;
  dcterms:description "Methodischer Ansatz zur Erstellung der Sachbilanz einschließlich des Modellierungsprinzips und der Behandlung von Mehrfunktionalität."@de ;
  dcterms:description "Methodological approach to compiling the inventory, including the modelling principle and treatment of multifunctionality."@en ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
