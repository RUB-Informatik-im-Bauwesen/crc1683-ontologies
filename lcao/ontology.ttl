lcao:hasUnitGroupVersion
  rdf:type rdf:Property ;
  rdf:type owl:DatatypeProperty ;
  dcterms:description "Records the version of the unit group data set."@en ;
  dcterms:description "Speichert den Versionsstand des Einheitengruppendatensatzes."@de ;
  dcterms:source <https://eplca.jrc.ec.europa.eu/LCDN/downloads/ILCD_Format_1.1_Documentation/ILCD_UnitGroupDataSet.html> ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:UnitGroup ;
  rdfs:label "has unit group data set version"@en ;
  rdfs:label "hat Version des Einheitengruppendatensatzes"@de ;
  rdfs:range xsd:string ;
.
lcao:refersToFlow
  rdf:type rdf:Property ;
  rdf:type owl:ObjectProperty ;
  dcterms:description "Links a process exchange to the data set identifying the exchanged flow."@en ;
  dcterms:description "Verknüpft einen prozessbezogenen Flusseintrag mit dem Datensatz des ausgetauschten Flusses."@de ;
  dcterms:source <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/ExchangeType.html> ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:Exchange ;
  rdfs:label "references flow"@en ;
  rdfs:label "referenziert Fluss"@de ;
  rdfs:range lcao:Flow ;
  rdfs:seeAlso <https://eplca.jrc.ec.europa.eu/LCDN/downloads/ILCD_Format_1.1_Documentation/ILCD_FlowDataSet.html> ;
.
lcao:refersToLCI-Method
  rdf:type rdf:Property ;
  rdf:type owl:ObjectProperty ;
  dcterms:description "Links an LCA process data set to the methodological approach used for inventory modelling."@en ;
  dcterms:description "Verknüpft einen LCA-Prozessdatensatz mit dem angewendeten methodischen Ansatz zur Sachbilanzmodellierung."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:Process ;
  rdfs:label "references inventory modelling approach"@en ;
  rdfs:label "referenziert Sachbilanzmodellierung"@de ;
  rdfs:range lcao:LCI-Method ;
  rdfs:seeAlso <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/LCIMethodAndAllocationType.html> ;
.
lcao:refersToLCIA-Method
  rdf:type rdf:Property ;
  rdf:type owl:ObjectProperty ;
  dcterms:description "Links an LCA process data set to the impact assessment method data set used."@en ;
  dcterms:description "Verknüpft einen LCA-Prozessdatensatz mit dem verwendeten Wirkungsabschätzungsmethodendatensatz."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:Process ;
  rdfs:label "references impact assessment method"@en ;
  rdfs:label "referenziert Wirkungsabschätzungsmethode"@de ;
  rdfs:range lcao:LCIA-Method ;
  rdfs:seeAlso <https://eplca.pages.code.europa.eu/ilcd_docs/schema/lciamethod/LCIAMethodDataSet.html> ;
.
lcao:representsProcess
  rdf:type rdf:Property ;
  rdf:type owl:ObjectProperty ;
  dcterms:description "Links an LCA process data set to the construction process represented in its inventory."@en ;
  dcterms:description "Verknüpft einen LCA-Prozessdatensatz mit dem darin bilanziell beschriebenen Bauprozess."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:Process ;
  rdfs:label "represents construction process"@en ;
  rdfs:label "repräsentiert Bauprozess"@de ;
  rdfs:range lcdmo:ConstructionProcess ;
  rdfs:seeAlso <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/processDataSet.html> ;
.
lcao:usedAllocationMethod
  rdf:type rdf:Property ;
  rdf:type owl:DatatypeProperty ;
  dcterms:description "Identifies the inventory modelling principle as attributional, consequential or a combination of these approaches."@en ;
  dcterms:description "Kennzeichnet das Sachbilanzprinzip als attributionell, konsequenziell oder als Kombination dieser Ansätze."@de ;
  dcterms:source <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/LCIMethodAndAllocationType.html> ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:LCI-Method ;
  rdfs:label "has inventory modelling principle"@en ;
  rdfs:label "hat Sachbilanz-Modellierungsprinzip"@de ;
  rdfs:range [
      rdf:type rdfs:Datatype ;
      owl:oneOf (
          "Attributional"
          "Consequential"
          "Consequential with attributional components"
          "Not applicable"
          "Other"
        ) ;
    ] ;
.
lcao:usedLCI-Method
  rdf:type rdf:Property ;
  rdf:type owl:DatatypeProperty ;
  dcterms:description "Identifies the approach used to address multifunctionality, such as mass allocation or substitution."@en ;
  dcterms:description "Kennzeichnet den angewendeten Ansatz zur Behandlung von Mehrfunktionalität, beispielsweise Massenallokation oder Substitution."@de ;
  dcterms:source <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/LCIMethodAndAllocationType.html> ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:LCI-Method ;
  rdfs:label "has allocation or substitution approach"@en ;
  rdfs:label "hat Allokations- oder Substitutionsansatz"@de ;
  rdfs:range [
      rdf:type rdfs:Datatype ;
      owl:oneOf (
          "Allocation - market value"
          "Allocation - gross calorific value"
          "Allocation - net calorific value"
          "Allocation - exergetic content"
          "Allocation - element content"
          "Allocation - mass"
          "Allocation - volume"
          "Allocation - ability to bear"
          "Allocation - marginal causality"
          "Allocation - physical causality"
          "Allocation - 100% to main function"
          "Allocation - other explicit assignment"
          "Allocation - equal distribution"
          "Substitution - BAT"
          "Substitution - average, market price correction"
          "Substitution - average, technical properties correction"
          "Allocation - recycled content"
          "Substitution - recycling potential"
          "Substitution - average, no correction"
          "Substitution - specific"
          "Consequential effects - other"
          "Not applicable"
          "Other"
        ) ;
    ] ;
  rdfs:seeAlso <https://www.iso.org/standard/38498.html> ;
.
lcao:usedLCIA-Method
  rdf:type rdf:Property ;
  rdf:type owl:DatatypeProperty ;
  dcterms:description "Identifies the impact assessment method family or reference package used, such as Environmental Footprint or EN 15804."@en ;
  dcterms:description "Kennzeichnet die verwendete Methodenfamilie oder das Referenzpaket der Wirkungsabschätzung, beispielsweise Environmental Footprint oder EN 15804."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:domain lcao:LCIA-Method ;
  rdfs:label "has impact assessment method family"@en ;
  rdfs:label "hat Wirkungsabschätzungs-Methodenfamilie"@de ;
  rdfs:range [
      rdf:type rdfs:Datatype ;
      owl:oneOf (
          "Environmental Footprint"
          "EN 15804 reference package"
          "ReCiPe"
          "CML-IA"
          "TRACI"
          "ILCD 2011"
          "IMPACT 2002+"
          "IMPACT World+"
          "LC-IMPACT"
          "LIME"
          "EDIP"
          "Eco-indicator 99"
          "Ecological Scarcity"
          "EPS"
          "Eco-costs"
        ) ;
    ] ;
  rdfs:seeAlso <https://eplca.pages.code.europa.eu/ilcd_docs/schema/lciamethod/LCIAMethodDataSet.html> ;
.
