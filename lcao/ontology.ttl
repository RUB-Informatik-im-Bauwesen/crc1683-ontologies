lcao:LCA-DataSet
  rdf:type owl:Class ;
  dcterms:description "Structured, identifiable collection of information used to model, document or evaluate a life cycle assessment."@en ;
  dcterms:description "Strukturierte, identifizierbare Zusammenstellung von Informationen zur Modellierung, Dokumentation oder Auswertung einer Ökobilanz."@de ;
  dcterms:source <https://eplca.pages.code.europa.eu/ilcd_docs/> ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:label "LCA data set"@en ;
  rdfs:label "Ökobilanzdatensatz"@de ;
  rdfs:subClassOf owl:Thing ;
.
lcao:LCA-Study
  rdf:type owl:Class ;
  dcterms:description "Investigation of a product system's potential environmental impacts according to a defined goal and scope."@en ;
  dcterms:description "Untersuchung potenzieller Umweltwirkungen eines Produktsystems anhand festgelegter Ziele und eines festgelegten Untersuchungsrahmens."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:label "Life cycle assessment study"@en ;
  rdfs:label "Ökobilanzstudie"@de ;
  rdfs:seeAlso <https://www.iso.org/standard/37456.html> ;
  rdfs:seeAlso <https://www.iso.org/standard/38498.html> ;
  rdfs:subClassOf owl:Thing ;
.
