  rdfs:seeAlso <https://www.iso.org/standard/38498.html> ;
  rdfs:subClassOf owl:Thing ;
.
lcao:LCI-Method_1
  rdf:type lcao:LCI-Method ;
  lcao:usedAllocationMethod "Attributional" ;
  lcao:usedLCI-Method "Allocation - mass" ;
.
lcao:LCI-Result
  rdf:type owl:Class ;
  dcterms:description "Quantified inventory-based indicator, represented here by primary energy demand, resource use or waste generation."@en ;
  dcterms:description "Quantifizierter sachbilanzbasierter Indikator, im Modell beispielsweise Primärenergiebedarf, Ressourceneinsatz oder Abfallaufkommen."@de ;
  dcterms:source <urn:ontology-annotation:source:lcao-input-sha256-6024a1d9ac470d4dbb34b6ec5677a4f2d644e647d06ae73c44f76849b41d7e8c> ;
  rdfs:label "Inventory-based indicator result"@en ;
  rdfs:label "Sachbilanzbasierter Indikatorwert"@de ;
  rdfs:seeAlso <https://eplca.pages.code.europa.eu/ilcd_docs/schema/process/processDataSet.html> ;
  rdfs:seeAlso <https://www.dinmedia.de/de/norm/din-en-15804/344735627> ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:decimal ;
      owl:onProperty lcdmo:hasValue ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty lcdmo:hasUnit ;
    ] ;
.
