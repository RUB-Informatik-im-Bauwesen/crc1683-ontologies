  <rdf:Description rdf:about="https://w3id.org/cero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/cero"/>
    <dc1:title xml:lang="de">Concrete Element Reuse Ontology (CERO)</dc1:title>
    <dc1:title xml:lang="en">Concrete Element Reuse Ontology (CERO)</dc1:title>
    <dc1:bibliographicCitation>Guntermann, L., Krautgartner, N., &amp; Hagedorn, P. Concrete Element Reuse Ontology (CERO). (2026). Version 1.0. https://www.w3id.org/cero .</dc1:bibliographicCitation>
    <dc1:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-01</dc1:created>
    <dc1:creator rdf:nodeID="n8719648be1e44d06896cfdbed6ec3014b1"/>
    <dc1:creator rdf:nodeID="n8719648be1e44d06896cfdbed6ec3014b2"/>
    <dc1:creator rdf:nodeID="n8719648be1e44d06896cfdbed6ec3014b3"/>
    <dc1:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-06</dc1:issued>
    <dc1:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dc1:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-15</dc1:modified>
    <dc1:publisher rdf:nodeID="n8719648be1e44d06896cfdbed6ec3014b4"/>
    <vann:preferredNamespacePrefix>cero</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:resource="https://w3id.org/cero#"/>
    <rdfs:comment>
CERO describes reusable cast-in-place reinforced concrete elements to support a circular economy in construction.
</rdfs:comment>
    <rdfs:label>Concrete Element Reuse Ontology (CERO)</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
    <skos:historyNote>
v0.1: initial ontology
  </skos:historyNote>
    <schema:codeRepository rdf:resource="https://github.com/RUB-Informatik-im-Bauwesen/crc1683-ontologies/tree/main/cero"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cero#initialFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
